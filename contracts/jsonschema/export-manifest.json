{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-fabric.dev/schemas/export-manifest.json",
  "title": "ExportManifest",
  "description": "Portable organization export manifest. Format version is independent of API version. Secrets, bearer tokens, and live credentials are never included.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "export_id",
    "organization_id",
    "created_at",
    "status",
    "checksums",
    "contents"
  ],
  "properties": {
    "format_version": {
      "type": "string",
      "const": "context-fabric.export/v1"
    },
    "export_id": {
      "type": "string",
      "minLength": 1
    },
    "organization_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include_evidence": {
          "type": "boolean",
          "default": true
        },
        "include_derived": {
          "type": "boolean",
          "default": false,
          "description": "Derived projections are optional; ledger + evidence are authoritative."
        },
        "include_audit": {
          "type": "boolean",
          "default": true
        },
        "context_space_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "as_of": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "legal_hold_respected": {
      "type": "boolean",
      "const": true
    },
    "checksums": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_sha256"],
      "properties": {
        "manifest_sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "archive_sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "contents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "sha256", "byte_size"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "records",
              "events",
              "evidence_index",
              "delegation_grants",
              "source_registrations",
              "mapping_specs",
              "audit",
              "authz_model_pin",
              "tombstones"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "byte_size": {
            "type": "integer",
            "minimum": 0
          },
          "record_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "policy_revision": {
      "type": "string"
    },
    "authz_model_id": {
      "type": "string",
      "description": "Pinned OpenFGA model ID at export time."
    },
    "download_uri": {
      "type": ["string", "null"],
      "format": "uri",
      "description": "Time-limited download URI when status=completed."
    },
    "expires_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "reason_code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}
