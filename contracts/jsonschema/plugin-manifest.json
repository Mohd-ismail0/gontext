{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-fabric.dev/schemas/plugin-manifest.json",
  "title": "PluginManifest",
  "description": "Connector/plugin package manifest. Plug-ins submit validated intake only; they cannot write canonical facts, alter authorization tuples, query arbitrary context, or call agent action endpoints.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "api_version",
    "kind",
    "runtime",
    "image_or_module_digest",
    "capabilities",
    "emits"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9_-]+)+$",
      "examples": ["com.example.chatwoot-source"]
    },
    "api_version": {
      "type": "string",
      "const": "context-fabric.plugin/v1"
    },
    "kind": {
      "type": "string",
      "enum": ["source", "parser", "enricher", "transform"]
    },
    "display_name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "runtime": {
      "type": "string",
      "enum": ["oci", "wasm"]
    },
    "image_or_module_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "config_schema_ref": {
      "type": "string",
      "format": "uri"
    },
    "trust_tier": {
      "type": "string",
      "enum": [
        "first_party_connector",
        "third_party_plugin",
        "deterministic_transform"
      ]
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_.:-]+$"
      },
      "description": "Explicit host capabilities. Network egress is deny-by-default."
    },
    "secrets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "Secret references only; values never embedded."
    },
    "emits": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "context.ingest.request.v1",
          "context.lifecycle.notification.v1"
        ]
      }
    },
    "egress_allowlist": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": []
    },
    "sbom_attestation_ref": {
      "type": ["string", "null"]
    },
    "signature_ref": {
      "type": ["string", "null"]
    },
    "forbidden": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "direct_database": {
          "type": "boolean",
          "const": true
        },
        "direct_nats": {
          "type": "boolean",
          "const": true
        },
        "direct_openfga": {
          "type": "boolean",
          "const": true
        },
        "broad_evidence_credentials": {
          "type": "boolean",
          "const": true
        }
      },
      "default": {
        "direct_database": true,
        "direct_nats": true,
        "direct_openfga": true,
        "broad_evidence_credentials": true
      }
    }
  }
}
