{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-fabric.io/schemas/context-packet.json",
  "title": "ContextPacket",
  "description": "Governed retrieval packet returned by REST and MCP. Version context-fabric.packet/v1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "organization_id",
    "purpose",
    "citations",
    "redactions",
    "policy_revision",
    "authz_revision",
    "audit_id",
    "action_restrictions"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "context-fabric.packet/v1"
    },
    "packet_id": { "type": "string" },
    "organization_id": { "type": "string", "minLength": 1 },
    "purpose": {
      "type": "string",
      "enum": ["support", "account_management", "marketing", "finance", "agent_assist"]
    },
    "summary": { "type": "string" },
    "redaction_profile": { "type": "string" },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/GraphNode" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/GraphEdge" }
    },
    "citations": {
      "type": "array",
      "items": { "$ref": "#/$defs/Citation" }
    },
    "redactions": {
      "type": "array",
      "items": { "$ref": "#/$defs/Redaction" }
    },
    "policy_revision": { "type": "string" },
    "authz_revision": { "type": "string" },
    "audit_id": { "type": "string" },
    "action_restrictions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "truncated": { "type": "boolean" },
    "next_cursor": {
      "type": "string",
      "description": "Truncation signal only in v1; resume pagination is not guaranteed."
    },
    "responded_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "GraphNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_id"],
      "properties": {
        "resource_id": { "type": "string" },
        "kind": { "type": "string" },
        "title": { "type": "string" },
        "classification": { "type": "string" },
        "labels": { "type": "array", "items": { "type": "string" } },
        "revision_id": { "type": "string" },
        "state": { "type": "string" },
        "attributes": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "GraphEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge_id", "from_id", "to_id", "predicate"],
      "properties": {
        "edge_id": { "type": "string" },
        "organization_id": { "type": "string" },
        "from_id": { "type": "string" },
        "to_id": { "type": "string" },
        "predicate": { "type": "string" },
        "confidence": { "type": "number" },
        "state": { "type": "string" },
        "sync_authz": { "type": "boolean" },
        "attributes": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "Citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_id", "revision_id"],
      "properties": {
        "citation_id": { "type": "string" },
        "resource_id": { "type": "string" },
        "revision_id": { "type": "string" },
        "snippet": { "type": "string" },
        "score": { "type": "number" }
      }
    },
    "Redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "reason_code"],
      "properties": {
        "profile": { "type": "string" },
        "reason_code": { "type": "string" },
        "fields": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
