{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-fabric.io/schemas/secrets-classification/v1.json",
  "title": "ContextFabricSecretsClassification",
  "description": "Classified secrets inventory for Context Fabric. Documents secret identity, classification, and rotation policy only — never secret values.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "secrets"],
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "context-fabric.io/v1"
    },
    "kind": {
      "type": "string",
      "const": "SecretsClassification"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[a-z0-9.]+)?$"
        }
      }
    },
    "secrets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/secretEntry" }
    }
  },
  "$defs": {
    "classification": {
      "type": "string",
      "enum": ["bootstrap", "rotatable", "external_ref"],
      "description": "bootstrap: one-time install secrets; rotatable: platform-managed credentials with rotation; external_ref: pointer to org-managed secret store."
    },
    "secretEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "classification",
        "used_by",
        "description",
        "rotation"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_./-]{1,127}$",
          "description": "Stable secret reference name used by config (e.g. postgres.context_gateway)."
        },
        "classification": { "$ref": "#/$defs/classification" },
        "used_by": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "serve",
              "worker",
              "connector",
              "migrate",
              "bootstrap",
              "doctor",
              "backup",
              "restore",
              "reconcile"
            ]
          }
        },
        "dependency": {
          "type": "string",
          "enum": ["postgres", "s3", "nats", "openfga", "oidc", "platform"]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "env_var": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "description": "Optional environment variable name that holds the secret value at runtime."
        },
        "external_provider": {
          "type": "string",
          "enum": [
            "kubernetes_secret",
            "external_secrets",
            "vault",
            "aws_secrets_manager",
            "gcp_secret_manager",
            "azure_key_vault",
            "coolify",
            "operator_file"
          ],
          "description": "Required when classification is external_ref."
        },
        "external_path": {
          "type": "string",
          "description": "Provider-specific path or key for external_ref secrets."
        },
        "rotation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy", "max_age_days"],
          "properties": {
            "policy": {
              "type": "string",
              "enum": ["never", "manual", "scheduled", "on_compromise"]
            },
            "max_age_days": {
              "type": "integer",
              "minimum": 0,
              "description": "0 means no scheduled expiry (bootstrap or never)."
            },
            "overlap_hours": {
              "type": "integer",
              "minimum": 0,
              "default": 24,
              "description": "Dual-accept window during rotation for rotatable secrets."
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "classification": { "const": "external_ref" } }
          },
          "then": {
            "required": ["external_provider", "external_path"]
          }
        }
      ]
    }
  },
  "examples": [
    {
      "apiVersion": "context-fabric.io/v1",
      "kind": "SecretsClassification",
      "metadata": {
        "name": "context-fabric-default",
        "version": "1.0.0"
      },
      "secrets": [
        {
          "name": "postgres.admin",
          "classification": "bootstrap",
          "dependency": "postgres",
          "used_by": ["migrate", "bootstrap"],
          "description": "PostgreSQL admin credentials used only during migrate/bootstrap.",
          "env_var": "POSTGRES_ADMIN_PASSWORD",
          "rotation": { "policy": "manual", "max_age_days": 0 }
        },
        {
          "name": "postgres.context_gateway",
          "classification": "rotatable",
          "dependency": "postgres",
          "used_by": ["serve", "worker", "migrate", "doctor", "backup", "restore", "reconcile"],
          "description": "Runtime NOBYPASSRLS role password for context_gateway.",
          "env_var": "POSTGRES_GATEWAY_PASSWORD",
          "rotation": { "policy": "scheduled", "max_age_days": 90, "overlap_hours": 24 }
        },
        {
          "name": "s3.access",
          "classification": "rotatable",
          "dependency": "s3",
          "used_by": ["serve", "worker", "doctor", "backup", "restore"],
          "description": "S3-compatible access key and secret for evidence buckets.",
          "env_var": "S3_SECRET_ACCESS_KEY",
          "rotation": { "policy": "scheduled", "max_age_days": 90, "overlap_hours": 24 }
        },
        {
          "name": "nats.credentials",
          "classification": "rotatable",
          "dependency": "nats",
          "used_by": ["serve", "worker", "doctor", "reconcile"],
          "description": "NATS user credentials or NKey for JetStream.",
          "env_var": "NATS_CREDENTIALS",
          "rotation": { "policy": "scheduled", "max_age_days": 90, "overlap_hours": 24 }
        },
        {
          "name": "openfga.api_token",
          "classification": "rotatable",
          "dependency": "openfga",
          "used_by": ["serve", "worker", "bootstrap", "doctor"],
          "description": "OpenFGA API token for store operations.",
          "env_var": "OPENFGA_API_TOKEN",
          "rotation": { "policy": "scheduled", "max_age_days": 90, "overlap_hours": 24 }
        },
        {
          "name": "openfga.store_id",
          "classification": "bootstrap",
          "dependency": "openfga",
          "used_by": ["serve", "worker", "bootstrap", "doctor"],
          "description": "OpenFGA store identifier created at bootstrap.",
          "env_var": "OPENFGA_STORE_ID",
          "rotation": { "policy": "never", "max_age_days": 0 }
        },
        {
          "name": "oidc.client_secret",
          "classification": "external_ref",
          "dependency": "oidc",
          "used_by": ["serve", "doctor"],
          "description": "OIDC client secret managed by the organization IdP.",
          "env_var": "OIDC_CLIENT_SECRET",
          "external_provider": "vault",
          "external_path": "secret/data/context-fabric/oidc",
          "rotation": { "policy": "on_compromise", "max_age_days": 180 }
        },
        {
          "name": "platform.webhook_signing",
          "classification": "rotatable",
          "dependency": "platform",
          "used_by": ["serve"],
          "description": "HMAC or asymmetric key material for signed change-feed webhooks.",
          "env_var": "WEBHOOK_SIGNING_SECRET",
          "rotation": { "policy": "scheduled", "max_age_days": 60, "overlap_hours": 48 }
        },
        {
          "name": "platform.deletion_signing",
          "classification": "rotatable",
          "dependency": "platform",
          "used_by": ["serve"],
          "description": "HMAC key material for signed deletion completion manifests.",
          "env_var": "DELETION_SIGNING_SECRET",
          "rotation": { "policy": "scheduled", "max_age_days": 60, "overlap_hours": 48 }
        },
        {
          "name": "platform.bootstrap_token",
          "classification": "bootstrap",
          "dependency": "platform",
          "used_by": ["serve", "bootstrap"],
          "description": "One-time token for first organization bootstrap in non-demo profiles.",
          "env_var": "PLATFORM_BOOTSTRAP_TOKEN",
          "rotation": { "policy": "never", "max_age_days": 0 }
        },
        {
          "name": "connector.source_credentials",
          "classification": "external_ref",
          "dependency": "platform",
          "used_by": ["connector"],
          "description": "Per-source connector credentials; never shared with serve/worker DB paths.",
          "external_provider": "kubernetes_secret",
          "external_path": "context-fabric/connector-source",
          "rotation": { "policy": "manual", "max_age_days": 90 }
        }
      ]
    }
  ]
}
