# Context Fabric starter Compose — production example values.
# Copy to .env.starter and replace every change-me-* / example.com placeholder.
# Never commit .env.starter with real secrets.

# ---------------------------------------------------------------------------
# Image / profile (digest-pin GONTEXT_IMAGE in production)
# ---------------------------------------------------------------------------
GONTEXT_IMAGE=ghcr.io/mohd-ismail0/gontext:1.0.0
# GONTEXT_IMAGE=ghcr.io/mohd-ismail0/gontext@sha256:...
# GONTEXT_IMAGE_DIGEST=sha256:...
GONTEXT_PULL_POLICY=if_not_present
CONTEXT_FABRIC_PROFILE=starter
INDEX_BACKEND=postgres

# ---------------------------------------------------------------------------
# TLS gateway (Caddy — only public surface)
# ---------------------------------------------------------------------------
PUBLIC_DOMAIN=context-fabric.lab.local
ACME_EMAIL=ops@your-org.example

# ---------------------------------------------------------------------------
# PostgreSQL (+ pgvector)
# ---------------------------------------------------------------------------
POSTGRES_DB=context_fabric
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-admin
POSTGRES_GATEWAY_USER=context_gateway
POSTGRES_GATEWAY_PASSWORD=change-me-postgres-gateway
POSTGRES_SSLMODE=disable
POSTGRES_DSN=postgres://context_gateway:change-me-postgres-gateway@postgres:5432/context_fabric?sslmode=disable
POSTGRES_ADMIN_DSN=postgres://postgres:change-me-postgres-admin@postgres:5432/context_fabric?sslmode=disable

# ---------------------------------------------------------------------------
# S3-compatible evidence store (MinIO)
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=change-me-minio-secret
S3_PATH_STYLE=true
S3_BUCKET_RAW=context-raw
S3_BUCKET_DERIVED=context-derived
S3_BUCKET_QUARANTINE=context-quarantine

# ---------------------------------------------------------------------------
# NATS JetStream (user/password — matches docker-compose.starter.yaml)
# ---------------------------------------------------------------------------
NATS_USER=context-fabric
NATS_PASSWORD=change-me-nats-password
NATS_DOMAIN=context-fabric-starter

# ---------------------------------------------------------------------------
# OpenFGA (preshared token — must match OPENFGA_AUTHN_PRESHARED_KEYS)
# ---------------------------------------------------------------------------
OPENFGA_API_URL=http://openfga:8080
OPENFGA_API_TOKEN=change-me-openfga-preshared-token
OPENFGA_STORE_ID=replace-after-bootstrap
OPENFGA_MODEL_ID=starter-model-v1

# ---------------------------------------------------------------------------
# OIDC (external IdP — required for starter; no local/demo auth)
# ---------------------------------------------------------------------------
OIDC_ISSUER=https://login.your-org.example/
OIDC_AUDIENCE=context-fabric
OIDC_CLIENT_ID=context-fabric-starter
OIDC_CLIENT_SECRET=change-me-oidc-client-secret
OIDC_DISCOVERY_URL=https://login.your-org.example/.well-known/openid-configuration
OIDC_JWKS_URL=https://login.your-org.example/oauth2/v1/keys

# ---------------------------------------------------------------------------
# Platform secrets (doctor fails closed when unset in starter)
# ---------------------------------------------------------------------------
WEBHOOK_SIGNING_SECRET=change-me-webhook-signing-secret
DELETION_SIGNING_SECRET=change-me-deletion-signing-secret
CONTEXT_FABRIC_LISTEN_ADDR=:8080
CONTEXT_FABRIC_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Capabilities
# ---------------------------------------------------------------------------
CAPABILITY_PGVECTOR=true
CAPABILITY_JETSTREAM_PERSISTENCE=true
CAPABILITY_S3_VERSIONING=true
CAPABILITY_S3_OBJECT_LOCK=true
CAPABILITY_OPENFGA_STORE=true
