# Context Fabric Compose environment — example values only.
# Copy to .env and replace placeholders. Never commit real secrets.

# ---------------------------------------------------------------------------
# Image / profile
# ---------------------------------------------------------------------------
CONTEXT_FABRIC_IMAGE=ghcr.io/xsama/context-fabric:1.0.0
# demo: Local tokens + memory OpenFGA (default for local Compose).
# starter: requires OIDC + real OPENFGA_STORE_ID (run bootstrap; pin store id / use OPENFGA_STORE_ID_FILE).
CONTEXT_FABRIC_PROFILE=demo
SERVE_PUBLIC_PORT=8080
# Durable index + AuthZ outbox worker share Postgres (required for split serve/worker).
INDEX_BACKEND=postgres

# ---------------------------------------------------------------------------
# PostgreSQL (+ pgvector)
# ---------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=context_fabric
# Container superuser (migrate/bootstrap/OpenFGA datastore only — not the app runtime role).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-admin
# Runtime NOBYPASSRLS role used by serve/worker (created in deploy/postgres/init/01_roles.sql).
POSTGRES_GATEWAY_USER=context_gateway
POSTGRES_GATEWAY_PASSWORD=change-me-postgres-gateway
POSTGRES_SSLMODE=disable
POSTGRES_DSN=postgres://context_gateway:change-me-postgres-gateway@postgres:5432/context_fabric?sslmode=disable

# ---------------------------------------------------------------------------
# S3-compatible evidence store (MinIO)
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=change-me-minio-secret
S3_PATH_STYLE=true
S3_BUCKET_RAW=context-raw
S3_BUCKET_DERIVED=context-derived
S3_BUCKET_QUARANTINE=context-quarantine
S3_VERSIONING=true
S3_OBJECT_LOCK=true

# ---------------------------------------------------------------------------
# NATS JetStream
# ---------------------------------------------------------------------------
NATS_URL=nats://nats:4222
NATS_DOMAIN=context-fabric-starter
NATS_CREDENTIALS=
NATS_JETSTREAM_STORAGE=file
NATS_JETSTREAM_REPLICAS=1

# ---------------------------------------------------------------------------
# OpenFGA
# ---------------------------------------------------------------------------
OPENFGA_API_URL=http://openfga:8080
OPENFGA_API_TOKEN=change-me-openfga-token
# Placeholder until bootstrap creates a store; compose writes the id to OPENFGA_STORE_ID_FILE.
OPENFGA_STORE_ID=replace-after-bootstrap
OPENFGA_STORE_ID_FILE=/var/run/context-fabric/openfga_store_id
OPENFGA_MODEL_ID=starter-model-v1

# ---------------------------------------------------------------------------
# OIDC (external IdP for starter; demo may point at a test issuer)
# ---------------------------------------------------------------------------
OIDC_ISSUER=https://idp.example.com/
OIDC_AUDIENCE=context-fabric
OIDC_CLIENT_ID=context-fabric-starter
OIDC_CLIENT_SECRET=change-me-oidc-client-secret
OIDC_DISCOVERY_URL=https://idp.example.com/.well-known/openid-configuration
OIDC_JWKS_URL=https://idp.example.com/oauth/jwks
OIDC_CLAIM_SUBJECT=sub
OIDC_CLAIM_EMAIL=email
OIDC_CLAIM_GROUPS=groups
OIDC_CLAIM_ORGANIZATION=org_id

# ---------------------------------------------------------------------------
# Platform / serve
# ---------------------------------------------------------------------------
CONTEXT_FABRIC_LISTEN_ADDR=:8080
CONTEXT_FABRIC_LOG_LEVEL=info
CONTEXT_FABRIC_CONFIG=/etc/context-fabric/config.yaml
WEBHOOK_SIGNING_SECRET=change-me-webhook-signing-secret
CAPABILITY_PGVECTOR=true
CAPABILITY_JETSTREAM_PERSISTENCE=true
CAPABILITY_S3_VERSIONING=true
CAPABILITY_S3_OBJECT_LOCK=true
CAPABILITY_OPENFGA_STORE=true
